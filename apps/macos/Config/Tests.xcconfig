#include "Base.xcconfig"

PRODUCT_NAME = MitoTests
PRODUCT_BUNDLE_IDENTIFIER = com.joacominatel.mito.tests
INFOPLIST_KEY_LSUIElement =

TEST_HOST = $(BUILT_PRODUCTS_DIR)/Mito.app/Contents/MacOS/Mito
BUNDLE_LOADER = $(TEST_HOST)
LD_RUNPATH_SEARCH_PATHS = $(inherited) @loader_path/../Frameworks

DEBUG_INFORMATION_FORMAT[config=Debug] = dwarf
ONLY_ACTIVE_ARCH[config=Debug] = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug] = DEBUG $(inherited)
SWIFT_OPTIMIZATION_LEVEL[config=Debug] = -Onone

#include? "Local.xcconfig"
