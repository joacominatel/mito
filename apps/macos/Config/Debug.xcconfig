#include "Base.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.joacominatel.mito.debug
INFOPLIST_KEY_CFBundleDisplayName = Mito Dev

// Ad-hoc signing plus library validation breaks Sparkle; Release keeps it on.
ENABLE_HARDENED_RUNTIME = NO

DEBUG_INFORMATION_FORMAT = dwarf
ENABLE_TESTABILITY = YES
GCC_OPTIMIZATION_LEVEL = 0
ONLY_ACTIVE_ARCH = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG $(inherited)
SWIFT_OPTIMIZATION_LEVEL = -Onone
OTHER_SWIFT_FLAGS = $(inherited) -Xfrontend -warn-long-function-bodies=200 -Xfrontend -warn-long-expression-type-checking=200

#include? "Local.xcconfig"
