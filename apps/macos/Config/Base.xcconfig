#include "Version.xcconfig"

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 15.0

SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES

PRODUCT_NAME = Mito
PRODUCT_BUNDLE_IDENTIFIER = com.joacominatel.mito
GENERATE_INFOPLIST_FILE = YES
// Merged into the generated plist; carries the Sparkle keys, which have no INFOPLIST_KEY_ form.
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Mito
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.games
INFOPLIST_KEY_LSUIElement = YES

// Outside the Mac App Store: the app reads the client's lockfile and process args (MITO_CONTEXT.md §24).
ENABLE_APP_SANDBOX = NO

// Sparkle (ADR 0009). Empty or `.invalid` keeps the updater off: no checks, no network.
MITO_SPARKLE_FEED_URL =
MITO_SPARKLE_PUBLIC_ED_KEY =
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -

ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
COMBINE_HIDPI_IMAGES = YES
COPY_PHASE_STRIP = NO
ENABLE_STRICT_OBJC_MSGSEND = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
