{
  "sourceLanguage" : "es",
  "strings" : {
    "%@ con %@ (%@ partidas)" : {
      "comment" : "Reason: synergy with a locked ally. Arguments: signed winrate points, ally champion, game count."
    },
    "%@ contra %@ (%@ en el equipo rival)" : {
      "comment" : "Reason: an item that counters an enemy trait. Arguments: item name, the trait (mucha curación), how many enemies have it."
    },
    "%@ contra %@ en el equipo rival (%@ partidas)" : {
      "comment" : "Reason: the delta against a locked enemy outside the lane. Arguments: signed winrate points, enemy champion, game count."
    },
    "%@ de promedio vs los más jugados de %@ (%@ rivales)" : {
      "comment" : "Reason: the expected lane matchup when the lane opponent is unknown, weighted by games over the role's most played champions. Arguments: signed winrate points, the role abbreviation (MID), how many of them had data."
    },
    "%@ de promedio vs los más jugados de %@ (1 rival)" : {
      "comment" : "Reason: the expected lane matchup when the lane opponent is unknown, against the role's most played champions; only one of them had data. Arguments: signed winrate points, the role abbreviation (MID)."
    },
    "%@ para tu %@ (%@ partidas)" : {
