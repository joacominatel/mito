    },
    "Runas" : {
      "comment" : "Loadout part: the rune page."
    },
    "Spells" : {
      "comment" : "Loadout part: the summoner spells."
    },
    "Suma el CC que le falta al equipo (más CC que el %@ del rol)" : {
      "comment" : "Reason: the team lacks crowd control. The argument is the candidate's CC percentile in its role."
    },
    "Tier %@ del parche (%@ partidas)" : {
      "comment" : "Reason: the candidate's tier this patch. Arguments: tier letter (S to D), game count."
    },
    "Tu equipo es %@ AD: aporta AP" : {
      "comment" : "Reason: the allied team is mostly physical damage and the candidate adds magic. The argument is the physical share."
